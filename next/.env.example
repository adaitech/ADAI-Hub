# URL pública do Strapi (API e imagens /uploads)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# URL do site (canonical, Open Graph, sitemap). ⚠️ PRODUÇÃO: domínio real (https://...)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google pode indexar este ambiente? Só "true" no servidor de PRODUÇÃO (lido no build).
# Ausente/qualquer outro valor = robots.txt "Disallow: /" e sitemap vazio (homologação e dev ficam fora do Google).
# ⚠️ PRODUÇÃO: SITE_INDEXAVEL=true + NEXT_PUBLIC_SITE_URL com o domínio real, ANTES do build.
# SITE_INDEXAVEL=true

# Token de leitura da API do Strapi (opcional em dev; recomendado em produção)
# STRAPI_API_TOKEN=

# Mesmo valor de PREVIEW_SECRET do strapi/.env (pré-visualização de rascunhos)
PREVIEW_SECRET=tobemodified

# Segredo do webhook do Strapi para revalidar o cache (header x-revalidate-secret)
REVALIDATE_SECRET=tobemodified

# Next 16 bloqueia otimizar imagens de IP local. Use true SOMENTE com Strapi em localhost.
# ⚠️ PRODUÇÃO: remover esta linha.
NEXT_IMAGE_ALLOW_LOCAL_IP=true

# CSP (src/proxy.ts) só observa e relata, sem bloquear. Usar na primeira semana de um ambiente novo
# e acompanhar "[csp] violação" no log; depois remover. Ver docs/seguranca/README.md §7.
# CSP_SOMENTE_RELATORIO=true

# Vitrine /componentes fora de desenvolvimento (homologação). Nunca em produção pública.
# SHOW_COMPONENTS=true

# inChurch Public API (fonte prioritária de dados da igreja). Só servidor: NUNCA usar prefixo NEXT_PUBLIC_.
# Cliente de API criado em https://admin.inchurch.com.br/api/clientes (só leitura, permissões mínimas).
INCHURCH_API_BASE_PUBLIC=https://api.inchurch.com.br/public
INCHURCH_API_KEY=
INCHURCH_API_SECRET=

# Série atual (YouTube Data API v3). Só servidor: NUNCA usar prefixo NEXT_PUBLIC_.
# Chave do Google Cloud restrita à YouTube Data API v3.
YOUTUBE_API_KEY=
# Handle do canal oficial, sem "@" (https://www.youtube.com/@ADAIOficial)
YOUTUBE_CHANNEL_HANDLE=ADAIOficial

# Google Tag Manager (DataLayer / GA4). ID público, não é segredo. Um container por ambiente:
#   homologação/dev: GTM-5945V9DQ (publicado) · produção: GTM-5MGM7CK2
# ⚠️ PRODUÇÃO: trocar para GTM-5MGM7CK2 ANTES do build (NEXT_PUBLIC_ é embutido no build) e
#    publicar o container de produção no GTM. Checklist completo: README.md → "Antes de subir para produção".
# Sem valor = nenhuma tag carrega (recomendado nos testes automatizados).
# O GA4 (G-SCG09PWV8B) é configurado dentro do GTM, não aqui. Ver docs/analytics/README.md.
NEXT_PUBLIC_GTM_ID=GTM-5945V9DQ
