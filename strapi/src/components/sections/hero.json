{
  "collectionName": "components_sections_heroes",
  "info": {
    "displayName": "Hero (abertura)",
    "icon": "picture",
    "description": "Primeira faixa da página: foto grande (preto e branco ou colorida), frase principal, texto abaixo dela e até dois botões."
  },
  "options": {},
  "attributes": {
    "titulo": {
      "type": "text",
      "required": true,
      "maxLength": 60
    },
    "texto_apoio": {
      "type": "text",
      "maxLength": 220
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "botoes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.botao",
      "max": 2
    },
    "subtitulo": {
      "type": "text",
      "maxLength": 220
    },
    "preto_e_branco": {
      "type": "boolean",
      "default": true
    }
  }
}
