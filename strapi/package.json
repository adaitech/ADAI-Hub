{
  "name": "adai-hub-strapi",
  "private": true,
  "version": "0.1.0",
  "description": "CMS do ADAI Hub (Strapi 5)",
  "scripts": {
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "data:export": "strapi export --no-encrypt --only content,files -f data/adai-conteudo",
    "data:import": "strapi import -f data/adai-conteudo.tar.gz --only content,files --force"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "dependencies": {
    "@strapi/plugin-seo": "2.0.9",
    "@strapi/plugin-users-permissions": "5.56.0",
    "@strapi/strapi": "5.56.0",
    "better-sqlite3": "11.7.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "resolutions": {
    "@swc/core": "1.15.47",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "nodemailer": "^9.1.1",
    "postcss": "^8.5.28",
    "@remix-run/router": "^1.23.4"
  },
  "strapi": {
    "telemetryDisabled": true
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
